{
  "$schema": "worker/node_modules/wrangler/config-schema.json",
  "name": "cf-ai-policy-as-code",
  "main": "worker/src/delivery/index.ts",
  "compatibility_date": "2026-11-01",
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "POLICY_DO",
        "class_name": "PolicyEngineDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PolicyEngineDO"]
    }
  ],
  "workflows": [
    {
      "name": "policy-authoring-workflow",
      "binding": "POLICY_WORKFLOW",
      "class_name": "PolicyAuthoringWorkflow"
    }
  ],
  "vars": {
    "OPA_SERVICE_URL": "https://cf-ai-opa-pdp.onrender.com"
  }
}