{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-policy-as-code",
  "main": "worker/src/delivery/index.ts",
  "compatibility_date": "2026-11-01",
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "POLICY_DO",
        "class_name": "PolicyEngineDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PolicyEngineDO"]
    }
  ],
  "workflows": [
    {
      "name": "policy-authoring-workflow",
      "binding": "POLICY_WORKFLOW",
      "class_name": "PolicyAuthoringWorkflow"
    }
  ],
  "containers": [
    {
      "class_name": "PolicyEngineDO",
      "image": "./opa-service/Dockerfile",
      "instance_type": "lite",
      "max_instances": 2
    }
  ],
  "vars": {
    "OPA_SERVICE_URL": "http://127.0.0.1:8080"
  }
}
